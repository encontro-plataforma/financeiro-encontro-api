{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Debug backend",
            "type": "python",
            "request": "launch",
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true
        },
        {
            "name": "Attach to uvicorn",
            "type": "python",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "${workspaceFolder}"
                }
            ]
        }
    ]
}